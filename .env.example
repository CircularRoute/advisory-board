# API keys load from environment variables at runtime — never hardcode or commit.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Only needed with --providers=...,google (Google is off by default)
GEMINI_API_KEY=
# Shared secret protecting the HTTP service and MCP endpoint (required for server)
ADVISORY_BOARD_KEY=
# Optional: where sittings/ and leaderboard.json are written (default: project root)
AB_DATA_DIR=
# Optional: a .env-style file to load keys from (CLI/server convenience)
AB_ENV_FILE=
